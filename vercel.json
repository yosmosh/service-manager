{
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "service-manager-two.vercel.app" }], "destination": "https://www.sad-budushego.ru/", "permanent": false },
    { "source": "/service-manager.html", "has": [{ "type": "host", "value": "service-manager-two.vercel.app" }], "destination": "https://www.sad-budushego.ru/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/service-manager.html" },
    { "source": "/app-version", "destination": "/service-manager.html" },
    { "source": "/db/:path*", "destination": "https://d5do4n0o23evidqovr16.jki8ffxa.apigw.yandexcloud.net/db/:path*" }
  ],
  "crons": [
    { "path": "/api/cron/sos-reminder", "schedule": "0 5 * * *" },
    { "path": "/api/cron/requests-reminder", "schedule": "5 5 * * *" },
    { "path": "/api/telegram/build-drafts", "schedule": "45 16 * * *" },
    { "path": "/api/cron/telegram-digest", "schedule": "0 17 * * *" },
    { "path": "/api/cron/warehouse-reminder", "schedule": "10 5 * * *" }
  ],
  "functions": {
    "api/telegram/build-drafts.js": { "maxDuration": 60 },
    "api/kitchen/scan-invoice.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/((?!vendor/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
